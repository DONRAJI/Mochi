# 서버 전용 (NEXT_PUBLIC_ 접두사 금지 — 붙이면 브라우저에 평문 노출)
DATABASE_URL=
DIRECT_URL=        # 마이그레이션용 직접 연결 (Supabase 풀러 우회 — schema.prisma의 directUrl)
# (SESSION_SECRET은 두지 않는다 — 세션이 opaque 랜덤 토큰 + DB sha256 방식이라 서명 시크릿이 필요 없다.)

# 외부 API 키 — 인제스트 스크립트 전용. 앱 런타임엔 안 쓰이므로 배포 env엔 넣을 필요 없다.
RECIPE_API_KEY=        # 식품안전나라 조리식품 레시피 DB(COOKRCP01) 인증키
# NUTRITION_API_KEY=   # data.go.kr 식품영양성분 DB — 미사용(영양 보강 후보)
# VISION_API_KEY=      # 사진→칼로리 인식 — 미착수(P2)

# Supabase Storage (식사 사진 — PRD 8-3). 서버 전용, NEXT_PUBLIC_ 금지.
SUPABASE_URL=                  # 프로젝트 URL (https://<ref>.supabase.co)
SUPABASE_SERVICE_ROLE_KEY=     # 서버 전용 시크릿 키(sb_secret_… 또는 service_role). 클라 노출 금지
SUPABASE_STORAGE_BUCKET=       # 비공개 버킷 이름 (image/* 전용)

# 레이트 리밋 공유 스토어 (Upstash Redis REST — 서버리스 멀티 인스턴스에서 유효).
# 없으면 인메모리 폴백(개발·단일 인스턴스). REST라 새 의존성 없음.
UPSTASH_REDIS_REST_URL=        # https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=      # Upstash REST 토큰 (서버 전용, 클라 노출 금지)

# 메일 발송 (이메일 인증 · 비밀번호 재설정). Brevo Transactional REST — 새 의존성 없음.
# 도메인이 *.vercel.app이라 DNS 인증이 불가능 → Brevo는 '발신자 이메일' 하나만 인증하면 된다.
# 키가 없으면 발송을 건너뛰고 서버 로그에 링크를 남긴다(제공자 붙이기 전 흐름 시험용).
BREVO_API_KEY=                 # Brevo > SMTP & API > API Keys
MAIL_FROM=                     # Brevo에서 인증한 발신 주소 (예: 05likesea@gmail.com)
MAIL_FROM_NAME=모찌             # 선택 — 받는 사람에게 보이는 이름
APP_URL=                       # 메일 링크 기준 주소 (배포: https://<앱 주소>). 없으면 Vercel 주소→localhost
# 앱 주소는 이 하나만 둔다. 클라(도감 공유 링크)는 window.location.origin을 쓰므로 env가 필요 없다.

# 웹푸시 저녁 리마인더 (옵트인). 키 생성: npx tsx scripts/generate-vapid.ts
# 없으면 설정의 알림 섹션이 스스로 숨는다(기능 꺼짐). 키를 바꾸면 기존 구독 전부 무효.
VAPID_PUBLIC_KEY=              # 65B 비압축 P-256 공개키(base64url) — 클라 구독에도 쓰이는 공개 정보
VAPID_PRIVATE_KEY=             # 32B d(base64url). 서버 전용, 클라 노출 금지
VAPID_SUBJECT=                 # mailto:<연락 이메일> (없으면 MAIL_FROM 폴백)
CRON_SECRET=                   # 아무 랜덤 문자열 — Vercel Cron이 /api/push/cron 호출 시 자동으로 붙임(외부 트리거 차단)

# FCM 네이티브 푸시 (Capacitor 앱 리마인더). Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 >
# "새 비공개 키 생성"으로 받은 JSON에서 세 값을 복사. 없으면 FCM 발송만 꺼짐(웹푸시는 계속).
FCM_PROJECT_ID=                # JSON의 project_id
FCM_CLIENT_EMAIL=              # JSON의 client_email
FCM_PRIVATE_KEY=               # JSON의 private_key — "-----BEGIN PRIVATE KEY-----\n..." 통째로(\n 유지, 따옴표 없이)
