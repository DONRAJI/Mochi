{
  "appId": "app.vercel.mochi_nu_ashen.twa",
  "appName": "모찌 다이어트",
  "webDir": "www",
  "server": {
    "url": "https://mochi-nu-ashen.vercel.app",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#FFF8F0",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
